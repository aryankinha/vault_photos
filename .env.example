# VaultPhotos app environment.
# The app NEVER holds the HF token — only the worker URL it talks to.
# Copy to `.env` (gitignored) and point at your deployed Cloudflare Worker.
VITE_WORKER_URL=https://vaultphotos-proxy.<your-subdomain>.workers.dev
# Send the gateway's HttpOnly Access session cookie. Prefer same-site domains.
VITE_ACCESS_CREDENTIALS=include
